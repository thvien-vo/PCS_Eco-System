# PCS Eco-System — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.

# Mapbox GL JS public token (used for the PCS Station Map — Module 2)
# Get a free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase — Auth Integration (used for user accounts and cross-device sync)
# Get these from your Supabase project → Settings → API
# Use the PUBLISHABLE key (formerly called "anon" key) — NOT the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here
